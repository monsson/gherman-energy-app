# Fallback SPA pentru Tomcat (RewriteValve, pornita din META-INF/context.xml).
#
# Caile sunt relative la contextul in care e montata aplicatia, deci fisierul nu stie nimic despre
# subcale: merge la fel sub `/pwa/`, sub `/gherman-energy-app/` sau in radacina.

# Ce exista pe disc se serveste ca atare: tot ce e sub `assets/` si orice cale cu extensie
# (favicon.ico, index.html). Rutele aplicatiei nu contin punct - nici UUID-urile din `/car/:id`.
RewriteRule ^/(assets/.*|.*\.[A-Za-z0-9]+)$ - [L]

# Restul sunt rute de client: le raspunde `index.html`, cu status 200, iar routerul preia calea.
RewriteRule ^/.*$ /index.html [L]
