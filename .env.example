# Backendul CUBA. Lasa gol (sau sterge fisierul .env) ca aplicatia sa ruleze pe datele demo,
# cu conturile hardcodate fleet/fleet si sofer/sofer.
#
# Radacina aplicatiei web, fara /rest/v2 la final:
VITE_API_BASE_URL=http://localhost:8080/app

# Clientul OAuth2 din modules/web/src/ro/gsdata/gp/web-app.properties.
# Secretul se trece fara prefixul {noop}. Ajunge in bundle-ul din browser (CUBA cere Basic auth
# pe /rest/v2/oauth/token si nu are flow pentru clienti publici), deci trateaza-l ca public.
VITE_API_CLIENT_ID=gp-iC8cROSH
VITE_API_CLIENT_SECRET=c00b075e9509ea8128d74558c6efdf7057b4bdbff693340a1134153450ecc524

# Subcalea de pe care este servita aplicatia, asa cum apare in URL (NU numele folderului de pe
# server, daca cele doua difera). Se compileaza in bundle, deci trebuie setata la build, nu la
# deploy: un build facut pentru alta subcale incarca o pagina goala, pentru ca toate asset-urile
# dau 404. Gol = /gherman-energy-app/ (GitHub Pages). Foloseste / pentru radacina domeniului.
BASE_PATH=/pwa/

# Videoclipurile ghidului de utilizare (`/guide`): unul pentru manageri (`manager.ro.mp4`) si unul
# pentru soferi (`sofer.ro.mp4`). Nu sunt in bundle: se copiaza pe server, in `guide/` de langa
# `index.html` (ex. `webapps/pwa/guide/manager.ro.mp4`). Seteaza doar daca sunt gazduite in alta
# parte; gol = `guide/` relativ la BASE_PATH.
#VITE_GUIDE_MEDIA_URL=https://gp.gsdata.ro/pwa/guide/
